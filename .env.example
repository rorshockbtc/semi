# Copy to .env.local (gitignored) and add your Google AI Studio Gemini API key:
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional model override (defaults to gemini-3.5-flash-lite, falling back to gemini-flash-lite-latest & gemini-3.8-flash)
SEMI_GEMINI_MODEL=gemini-3.5-flash-lite

# Optional secondary fallback provider
OPENAI_API_KEY=
