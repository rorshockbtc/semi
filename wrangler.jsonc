{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "semi",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "keep_vars": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "semi-mailing-list",
      "database_id": "2b5f729f-000f-44c2-b101-d486b47fc87e"
    }
  ],
  "observability": {
    "enabled": true
  }
}
